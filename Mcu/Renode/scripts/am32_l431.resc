:name: AM32 L431
:description: boots an AM32 STM32L431 firmware ELF

# Common to every L431 target. Do not include this directly - include a
# generated per-target .resc, which sets $platform and then comes here.
# See am32_f051.resc for what the variables mean; the differences from
# the other families are noted below.

$repo?=@.
$elf?=@none
$eeprom?=@none
$platform?=@none

# first, because each .cs is compiled on its own against the ones
# included before it: the comparator interface has to exist before
# anything implements it or looks one up
include $repo/Mcu/Renode/peripherals/common/IAM32Comparator.cs
include $repo/Mcu/Renode/peripherals/common/AM32_RegisterFile.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32F0_DMA.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32_CaptureTimer.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32_AdvancedTimer.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32_BasicTimer.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32_FreeRunningTimer.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32L4_Comp.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32_IWDG.cs
include $repo/Mcu/Renode/peripherals/common/AM32ThrottleGenerator.cs
include $repo/Mcu/Renode/peripherals/common/AM32_F051_Bridge.cs
include $repo/Mcu/Renode/peripherals/common/AM32_Sigrok.cs
# after the bridge, which it samples for the physics sensor values
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32F0_ADC.cs
# the LED strip decoder, whose type the guilink names
include $repo/Mcu/Renode/peripherals/common/AM32_Ws2812.cs
# after the bridge and the generator, whose types it names
include $repo/Mcu/Renode/peripherals/common/AM32_GuiLink.cs
# the mcast CAN bridge the _CAN target overlays declare
include $repo/Mcu/Renode/peripherals/common/AM32_CanMcast.cs

mach create "am32"
machine LoadPlatformDescription $platform

sysbus LoadELF $elf

# set by the generated per-target script: a 128k part keeps its settings
# at 0x0801F800 where a 64k one uses 0x0800F800, and a DroneCAN build
# links at 0x08004000 above the 16K CAN bootloader
$eeprom_addr?=0x0800F800
$app_base?=0x08001000
sysbus LoadBinary $eeprom $eeprom_addr

# Factory temperature calibration. The L4 shares the G0's addresses and
# conditions - 3.0V reference, second point at 130C, voltage rising with
# temperature - but these are representative L4 numbers (V30 = 0.76V,
# 2.5mV/C slope), not the G0's values.
sysbus WriteWord 0x1FFF75A8 1037
sysbus WriteWord 0x1FFF75CA 1379

# The L4 app never writes VTOR itself - initAfterJump() only enables
# interrupts - so the CPU must be pointed at the app vector table here.
cpu VectorTableOffset $app_base

# ... and again after every reset. The firmware reboots itself on signal
# loss (and DroneCAN's RestartNode does the same on request), and Renode
# restores the CPU's default vector table at 0 when it resets; nothing
# is mapped there but the empty bootloader region, so without this the
# CPU halts while the emulation looks healthy.
macro reset
"""
    cpu VectorTableOffset $app_base
"""


# NOT the one-instruction-per-cycle 80 of the other families' scripts:
# the L431 runs from 4-wait-state flash with no cache, so real code
# retires well under one instruction per cycle. The number matters
# beyond realism. At 80 MIPS the dshot DMA re-arm in the capture ISR
# fits inside the first bit's 1.25us high time, so a window that locked
# one edge late misses the frame's first edge again every re-arm and
# measures ~250us frametimes for exactly the eight windows
# computeDshotDMA() averages into its accept bounds - after which every
# real 51us frame is silently discarded and the ESC arms deaf. At 48
# MIPS the re-arm overruns into the next edge, the window drifts into
# the inter-frame gap and alignment becomes the only stable state, as
# on hardware.
cpu PerformanceInMips 48

emulation SetGlobalQuantum "0.001"
emulation SetGlobalAdvanceImmediately true
