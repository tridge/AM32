:name: AM32 F051
:description: boots an AM32 STM32F051 firmware ELF

# Common to every F051 target. Do not include this directly - include
# scripts/targets/<TARGET>.resc, which sets $platform and then comes
# here.
#
# Paths are absolute, supplied by the caller, because the test harness
# runs from a scratch directory like the SITL suite does. $elf is
# required; $eeprom is optional but you almost always want it, since
# unbacked Renode memory reads as zero whereas erased flash reads 0xFF,
# and a zeroed eeprom sends the firmware down the migration path.
#
# $platform must already be set. It cannot be built from a target name
# here: the monitor expands a path variable at the start of a path but
# leaves a second one later in the same path alone, so
# "$repo/.../$target.repl" would resolve to a literal "$target.repl".

$repo?=@.
$elf?=@none
$eeprom?=@none
$platform?=@none

# first, because each .cs is compiled on its own against the ones
# included before it: the comparator interface has to exist before
# anything implements it or looks one up
include $repo/Mcu/Renode/peripherals/common/IAM32Comparator.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32F0_RCC.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32F0_DMA.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32_CaptureTimer.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32_AdvancedTimer.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32F0_SysCfgComp.cs
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32_IWDG.cs
include $repo/Mcu/Renode/peripherals/common/AM32ThrottleGenerator.cs
include $repo/Mcu/Renode/peripherals/common/AM32_F051_Bridge.cs
# after the bridge: each .cs is compiled on its own, so a file may only
# reference types from one included before it. The ADC samples the
# bridge for the physics sensor values.
include $repo/Mcu/Renode/peripherals/stm32/AM32_STM32F0_ADC.cs
# after the bridge and the generator, whose types it names
include $repo/Mcu/Renode/peripherals/common/AM32_GuiLink.cs

mach create "am32"
machine LoadPlatformDescription $platform

sysbus LoadELF $elf

# Required, not optional. Renode zero-fills unbacked memory whereas
# erased flash reads 0xFF, and the firmware keys off that: tune[0] !=
# 0xFF diverts playStartupTune() into playBlueJayTune(), and a zeroed
# settings block sends loadEEpromSettings() down the migration path with
# motor_poles = 0. Generate with Mcu/SITL/sitl_params.py build_image().
$eeprom_addr?=0x08007C00
sysbus LoadBinary $eeprom $eeprom_addr

# Factory temperature calibration. Renode zero-fills the system memory
# page, and __LL_ADC_CALC_TEMPERATURE divides by (TS_CAL2 - TS_CAL1), so
# an unseeded pair makes every temperature reading meaningless. These are
# representative STM32F051 values rather than any particular die: the
# sensor sits near 1.43V at 30C and falls about 4.3mV/C, which is 1774
# and 1348 counts at 3.3V full scale.
sysbus WriteWord 0x1FFFF7B8 1774
sysbus WriteWord 0x1FFFF7C2 1348

# Cortex-M0 has no VTOR. The firmware copies its vector table to SRAM
# and remaps it to 0 via SYSCFG MEM_MODE; the copy holds the same
# handler addresses, so pointing the CPU at the flash table is
# vector-equivalent. It is NOT MEM_MODE-equivalent: reads through the
# 0x0 alias still see flash, which changes checkDeviceInfo(). Fine
# while no bootloader is loaded, revisit before one is.
cpu VectorTableOffset 0x08001000

# ... and again after every reset. The firmware reboots itself on signal
# loss, which any interactive session hits within a minute, and Renode
# restores the CPU's default vector table at 0 when it resets. Nothing
# is mapped there but an empty 4K bootloader region, so SP and PC both
# read zero, the CPU halts with "PC does not lay in memory", and the ESC
# is dead for the rest of the run while the emulation carries on looking
# healthy. Renode says as much when this macro is missing: "No action
# for reset - macro <machine>.reset is not registered".
macro reset
"""
    cpu VectorTableOffset 0x08001000
"""


# Renode charges virtual time at a nominal instruction rate rather than
# from the real instruction stream, and its default is 100 MIPS. This
# target is a 48MHz Cortex-M0, so the default models a core twice as
# fast as the hardware AND makes the emulator execute twice as many
# instructions per simulated second as it needs to. 48 is one
# instruction per cycle, which is the optimistic end for an M0 running
# from flash with a wait state - so it is both more faithful than the
# default and about 2.7x cheaper. Lower values buy a little more speed
# at the cost of modelling a slower core than the real one.
cpu PerformanceInMips 48

# The quantum is a synchronisation interval, not a timer resolution:
# virtual time stays nanosecond-resolution and timer reads still
# synchronise precisely within a quantum. So this does not coarsen
# commutation timing on a single machine. 1ms is the knee - going finer
# is expensive (1us costs about 2.6x) and coarser buys nothing. Revisit
# only if comparator edges ever arrive from another time domain.
emulation SetGlobalQuantum "0.001"

# never throttle to real time; we are far below it anyway, but this
# stops later optimisation from being capped at 1x
emulation SetGlobalAdvanceImmediately true
