// STM32F051 common to every AM32 F051 target. Not loadable on its own:
// it deliberately leaves out the capture timer, the comparator and the
// throttle wiring, which differ per hardware group. Load one of
// platforms/targets/*.repl instead.
//
// Vendored from Renode's platforms/cpus/stm32f0.repl (Antmicro, MIT) -
// see README.md for why it is copied rather than `using`d, and what was
// changed.
//
// An overlay may only ADD to this file. Redeclaring a name that is
// already here fails with "Variable 'x' was already declared", which is
// why anything a target needs to declare for itself is absent below
// rather than given a default here.

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 48000000
    IRQ -> cpu@0

exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40010400
    numberOfOutputLines: 32
    [0, 1] -> nvicInput5@[0, 1]
    [2, 3] -> nvicInput6@[0, 1]
    [4-15] -> nvicInput7@[0-11]
    [21, 22] -> nvicInput12@[0, 1]
    [25] -> nvicInput27@[0]
    [26] -> nvicInput28@[0]
    [28] -> nvicInput29@[0]
    [18, 23, 27] -> nvic@[31, 23, 30]

nvicInput5: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@5

nvicInput6: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@6

nvicInput7: Miscellaneous.CombinedInput @ none
    numberOfInputs: 12
    -> nvic@7

nvicInput12: Miscellaneous.CombinedInput @ none
    numberOfInputs: 3
    -> nvic@12

nvicInput27: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@27

nvicInput28: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@28

nvicInput29: Miscellaneous.CombinedInput @ none
    numberOfInputs: 7
    -> nvic@29

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0"
    nvic: nvic

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 200000000
    IRQ -> nvicInput27@1

usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 200000000
    IRQ -> nvicInput28@1

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 200000000
    IRQ -> nvicInput29@1

usart4: UART.STM32F7_USART @ sysbus 0x40004C00
    frequency: 200000000
    IRQ -> nvicInput29@2

usart5: UART.STM32F7_USART @ sysbus 0x40005000
    frequency: 200000000
    IRQ -> nvicInput29@3

usart6: UART.STM32F7_USART @ sysbus 0x40011400
    frequency: 200000000
    IRQ -> nvicInput29@4

usart7: UART.STM32F7_USART @ sysbus 0x40011800
    frequency: 200000000
    IRQ -> nvicInput29@5

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    modeResetValue: 0x28000000
    pullUpPullDownResetValue: 0x24000000
    numberOfAFs: 8
    invertedAFPins: [[1, 5], [7, 2]]
    [0-15] -> exti@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    invertedAFPins: [[0, 2], [1, 2], [6, 2], [7, 2], [13, 2], [14, 2], [15, 2, 3]]
    [0-15] -> exti@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x48000800, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x48000C00, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x48001000, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x48001400, +0x400>
    modeResetValue: 0x28000000
    pullUpPullDownResetValue: 0x24000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400

i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800

spi1: SPI.STM32SPI @ sysbus 0x40013000
    IRQ -> nvic@25

spi2: SPI.STM32SPI @ sysbus 0x40003800
    IRQ -> nvic@26

// motor PWM. The stock STM32_Timer has no MOE, no complementary
// outputs, no dead time and no preload shadowing, and keeps its
// register fields private.
timer1: Timers.AM32_STM32_AdvancedTimer @ sysbus 0x40012C00
    frequency: 48000000
    0 -> nvic@13
    1 -> nvic@14

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 48000000
    initialLimit: 0xFFFFFFFF
    -> nvic@15

// timer3 and timer15 are declared by the target overlay, not here: the
// two hardware groups swap their roles. F0_A captures the throttle on
// TIM15 and leaves TIM3 general purpose; F0_B does the reverse. Since
// an overlay cannot redeclare, neither can have a default here.

timer6: Timers.STM32_Timer @ sysbus 0x40001000
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@17

// TIM7 and TIM16 are intentionally absent: no F051 target initializes them,
// and each stock timer adds five entries to Renode's global clock update.
timer14: Timers.STM32_Timer @ sysbus 0x40002000
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@19

timer17: Timers.STM32_Timer @ sysbus 0x40014800
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@22

can: CAN.STMCAN @ sysbus <0x40006400, +0x400>

rtc: Timers.STM32F4_RTC @ sysbus 0x40002800
    // missing TamperIRQ, TimeStampIRQ, WakeupEventIRQ
    AlarmIRQ -> exti@17

rcc: Miscellaneous.AM32_STM32F0_RCC @ sysbus 0x40021000

// Not a tag: the main loop kicks the watchdog constantly, and against a
// tag every kick logs a warning that buries the ones worth reading.
iwdg: Miscellaneous.AM32_STM32_IWDG @ sysbus <0x40003000, +0x400>


// the adc is declared by the target overlay: its channels and scaling
// come from VOLTAGE_ADC_CHANNEL, CURRENT_ADC_CHANNEL,
// TARGET_VOLTAGE_DIVIDER, MILLIVOLT_PER_AMP and CURRENT_OFFSET, which
// differ per target

crc: CRC.STM32_CRC @ sysbus 0x40023000
    series: STM32Series.F0
    configurablePoly: false // Only STM32F07x and STM32F09x implements configurablePoly: true

// Alternate function mapping connections. For more details see `stm32l071.repl`.
// timer1's stock block is gone for the same reason timer15's is: a later
// block replaces an earlier one, and here it would have overwritten the
// nvic wiring with pin outputs. The motor model samples TIM1 by querying
// OutputRef(), not by listening for edges.

// timer3's and timer15's stock alternate-function blocks live in the
// overlays, next to the declarations they belong to.

timer14:
    0 -> gpioPortA#04@4 | gpioPortA#07@4 | gpioPortB#01@0

timer17:
    0 -> gpioPortA#07@5 | gpioPortB#07@2 | gpioPortB#09@2

sysbus:
    init:
        Tag <0x40002C00, 0x40002FFF> "WWDG"
        Tag <0x40005C00, 0x40005FFF> "USB "
        Tag <0x40006000, 0x400063FF> "USB/CAN SRAM"
        Tag <0x40006C00, 0x40006FFF> "CRS"
        Tag <0x40007000, 0x400073FF> "PWR"
        Tag <0x40007400, 0x400077FF> "DAC"
        Tag <0x40007800, 0x40007BFF> "CEC"
        Tag <0x40015800, 0x40015BFF> "DBGMCU"
        Tag <0x40020000, 0x400203FF> "DMA"
        Tag <0x40020400, 0x400207FF> "DMA2"
        Tag <0x40022000, 0x400223FF> "FLASH_INTERFACE"
        Tag <0x40023000, 0x400233FF> "CRC"
        Tag <0x40024000, 0x400243FF> "TSC"

// ---- F051 specifics ----------------------------------------------
// 32K flash / 8K SRAM. The app links at 0x08001000, above a 4K
// bootloader region that is left empty - no bootloader is loaded, and
// the CPU is pointed straight at the app vector table instead.
//
// flashAlias is NOT an alias: it is a second, independent backing store
// at 0. Reads there see zeros, not flash. That is why checkDeviceInfo()
// finds no devinfo record at 0x00000FE0 - correct while no bootloader
// exists, but correct by accident. Making it a real alias means
// registering the one memory at both addresses.
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x8000

flashAlias: Memory.MappedMemory @ sysbus 0x0
    size: 0x8000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x2000

// factory calibration page. The 1kHz ADC path reads the temperature
// calibration halfwords at 0x1FFFF7B8 and 0x1FFFF7C2; an unbacked read
// pair divides by zero in __LL_ADC_CALC_TEMPERATURE.
systemMemory: Memory.MappedMemory @ sysbus 0x1FFFF000
    size: 0x1000

// DMA1. The stock platform's Python stub threw as soon as the firmware
// programmed it; this one is request driven and widens 16-bit
// peripheral reads into 32-bit buffer slots. Which channel carries the
// capture, and so which one raises DMA1_Channel4_5_IRQn, is set by the
// overlay.
dma: DMA.AM32_STM32F0_DMA @ sysbus 0x40020000
    numberOfChannels: 7

// The bridge is declared by the target overlay, not here: its phase pin
// map is a required constructor argument and differs per target, and a
// default here would be silently wrong for the targets that rotate the
// phases across the same six pins.

// The throttle generator is declared by the overlay as well, next to the
// wiring that feeds it into both the capture timer and the input GPIO
// pin (transfercomplete() reads getInputPinState() to size the next
// transfer). Its address is family specific: 0x50000000 is outside
// anything the F051 decodes, but it is where the G0 puts GPIO.
