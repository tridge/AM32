// ARK_4IN1_F051 - HARDWARE_GROUP_F0_B in Inc/targets.h.
//
// Throttle in on PB4, captured by TIM3_CH1 into DMA1 channel 4.
// Comparator inputs: phase A on PA0, B on PA4, C on PA5 - A and C are
// swapped relative to F0_A.
//
// The phase bridge pins are identical to F0_A, so the bridge model needs
// nothing target specific.
//
// Not modelled, because the firmware does not depend on them: the
// DRV8328 nSLEEP on PA15 is driven high once at init and never lowered,
// and nFAULT on PB5 is configured as a pulled-up input and never read
// (Mcu/f051/Src/peripherals.c). Both are plain GPIO, so the stock port
// model handles the accesses.

using "../stm32f051_base.repl"

// Throttle capture. dma@3 is DMA1 channel 4 - Renode indexes from 0, the
// reference manual from 1. INPUT_DMA_CHANNEL is LL_DMA_CHANNEL_4.
//
// TIM3's stock alternate-function pin map is deliberately absent: a
// later connection block replaces an earlier one, so including it would
// silently override the DMA and NVIC wiring here and captures would go
// to GPIO pins instead. AM32 uses the capture timer as an input only.
timer3: Timers.AM32_STM32_CaptureTimer @ sysbus 0x40000400
    frequency: 48000000
    0 -> dma@3
    1 -> nvic@16

timer15: Timers.STM32_Timer @ sysbus 0x40014000
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@20

timer15:
    0 -> gpioPortA#01@5 | gpioPortA#02@0 | gpioPortB#14@1 | gpioPortB#15@3
    1 -> gpioPortA#03@0 | gpioPortB#15@1

// DMA1_Channel4_5_IRQn for the capture channel.
dma:
    3 -> nvic@11

// SYSCFG and COMP share a register page on the F051. The stock platform
// tags the whole thing, so COMP1OUT read back as nothing and BEMF
// sensing could not work. Line 21 is COMP1's EXTI line.
//
// The phase map is CSR[6:4], the COMP1 INMSEL field: 6 is PA0, 4 is PA4,
// 5 is PA5, matching PHASE_x_COMP for this group.
syscfgcomp: Miscellaneous.AM32_STM32F0_SysCfgComp @ sysbus <0x40010000, +0x400>
    phaseAInmsel: 6
    phaseBInmsel: 4
    phaseCInmsel: 5
    0 -> exti@21
    1 -> exti@22

// INPUT_PIN is PB4 on this group.
throttle:
    0 -> timer3@0 | gpioPortB@4
