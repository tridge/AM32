// FD6288_F051 - HARDWARE_GROUP_F0_A in Inc/targets.h.
//
// Throttle in on PA2, captured by TIM15_CH1 into DMA1 channel 5.
// Comparator inputs: phase A on PA5, B on PA4, C on PA0.

using "../stm32f051_base.repl"

// Throttle capture. The stock STM32_Timer has no input capture, so this
// is our model; it raises a DMA request rather than an interrupt per
// edge, as the firmware programs it to.
//
// dma@4 is DMA1 channel 5 - Renode indexes from 0, the reference manual
// from 1. INPUT_DMA_CHANNEL is LL_DMA_CHANNEL_5.
timer15: Timers.AM32_STM32_CaptureTimer @ sysbus 0x40014000
    frequency: 48000000
    0 -> dma@4
    1 -> nvic@20

// TIM15's stock alternate-function pin map is deliberately absent: a
// later connection block replaces an earlier one, so including it would
// silently override the DMA and NVIC wiring above and captures would go
// to GPIO pins instead. This cost real debugging time once. AM32 uses
// the capture timer as an input, never an output.

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    frequency: 48000000
    initialLimit: 0xFFFF
    -> nvic@16

timer3:
    0 -> gpioPortA#06@1 | gpioPortB#04@1 | gpioPortC#06@1
    1 -> gpioPortA#07@1 | gpioPortB#05@1 | gpioPortC#07@1
    2 -> gpioPortB#00@1 | gpioPortC#08@1
    3 -> gpioPortB#01@1 | gpioPortC#09@1

// DMA1_Channel4_5_IRQn for the capture channel.
dma:
    4 -> nvic@11

// SYSCFG and COMP share a register page on the F051. The stock platform
// tags the whole thing, so COMP1OUT read back as nothing and BEMF
// sensing could not work. Line 21 is COMP1's EXTI line.
//
// The phase map is CSR[6:4], the COMP1 INMSEL field: 5 is PA5, 4 is PA4,
// 6 is PA0, matching PHASE_x_COMP for this group. Getting it wrong is
// silent - the motor simply never commutates cleanly - so it is stated
// per target rather than defaulted.
syscfgcomp: Miscellaneous.AM32_STM32F0_SysCfgComp @ sysbus <0x40010000, +0x400>
    phaseAInmsel: 5
    phaseBInmsel: 4
    phaseCInmsel: 6
    0 -> exti@21
    1 -> exti@22

// INPUT_PIN is PA2 on this group.
throttle:
    0 -> timer15@0 | gpioPortA@2
