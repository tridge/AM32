// Main Flash memory
// Upper size:
// STM32G0B1xx and STM32G0C1xx: 0x0807 FFFF; STM32G071xx and STM32G081xx: 0x0801 FFFF; STM32G051xx and
// STM32G061xx, STM32G031xx and STM32G041xx: 0x0800 FFFF.
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x20000

ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0xC000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 72000000
    IRQ -> cpu@0

// Renode's own G0 platform puts an STM32F4_EXTI here, with a comment
// admitting the registers do not match. They really do not: the G0 has
// IMR1 at 0x80 and split rising/falling pending registers, so no
// comparator edge ever reached the NVIC. This is a G0 model.
exti: IRQControllers.AM32_STM32G0_EXTI @ sysbus 0x40021800
    numberOfOutputLines: 34
    firstDirectLine: 19
    [0, 1] -> nvicInput5@[0, 1]
    [2, 3] -> nvicInput6@[0, 1]
    [4-15] -> nvicInput7@[0-11]
    [23] -> nvic@[23]
    [32, 33] -> nvicInput8@[0, 1]
    [17, 18] -> nvicInput12@[0, 1]

nvicInput8: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@8

nvicInput10: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@10

nvicInput11: Miscellaneous.CombinedInput @ none
    numberOfInputs: 9
    -> nvic@11

// ADC1_COMP_IRQn, shared by the ADC and EXTI lines 17 and 18. Three
// inputs rather than the stock two, because the target overlay adds the
// ADC alongside the two comparator lines.
nvicInput12: Miscellaneous.CombinedInput @ none
    numberOfInputs: 3
    -> nvic@12

nvicInput5: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@5

nvicInput6: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@6

nvicInput7: Miscellaneous.CombinedInput @ none
    numberOfInputs: 12
    -> nvic@7

nvicInput29: Miscellaneous.CombinedInput @ none
    numberOfInputs: 4
    -> nvic@29

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0"
    nvic: nvic

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 200000000
    IRQ -> nvic@27

usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 200000000
    IRQ -> nvic@28

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 200000000
    IRQ -> nvicInput29@0

usart4: UART.STM32F7_USART @ sysbus 0x40004C00
    frequency: 200000000
    IRQ -> nvicInput29@1

usart5: UART.STM32F7_USART @ sysbus 0x40005000
    frequency: 200000000
    IRQ -> nvicInput29@2

usart6: UART.STM32F7_USART @ sysbus 0x40013C00
    frequency: 200000000
    IRQ -> nvicInput29@3

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x50000000, +0x400>
    modeResetValue: 0xEBFFFFFF
    pullUpPullDownResetValue: 0x24000000
    numberOfAFs: 8
    invertedAFPins: [[7, 2]]
    [0-15] -> exti@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x50000400, +0x400>
    modeResetValue: 0xFFFFFFFF
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    invertedAFPins: [[0, 2], [1, 2], [6, 2], [7, 2], [13, 2], [14, 2], [15, 2]]
    [0-15] -> exti@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x50000800, +0x400>
    modeResetValue: 0xFFFFFFFF
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x50000C00, +0x400>
    modeResetValue: 0xFFFFFFFF
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    invertedAFPins: [[2, 2], [3, 2]]
    [0-15] -> exti@[0-15]

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x50001000, +0x400>
    modeResetValue:0xFFFFFFFF
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x50001400, +0x400>
    modeResetValue: 0xFFFFFFFF
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    EventInterrupt -> exti@23

i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800
    EventInterrupt -> exti@22

spi1: SPI.STM32SPI @ sysbus 0x40013000
    IRQ -> nvic@25

spi2: SPI.STM32SPI @ sysbus 0x40003800
    IRQ -> nvic@26

spi3: SPI.STM32SPI @ sysbus 0x40003C00
    IRQ -> nvic@26

// motor PWM, the same model the F051 uses: the stock STM32_Timer has no
// MOE, no complementary outputs, no dead time and no preload shadowing.
// TIM1's register layout is the same on both families.
timer1: Timers.AM32_STM32_AdvancedTimer @ sysbus 0x40012C00
    frequency: 64000000
    0 -> nvic@13
    1 -> nvic@14

timer2: Timers.AM32_STM32_FreeRunningTimer @ sysbus 0x40000000
    frequency: 64000000
    initialLimit: 0xFFFFFFFF
    synchronize: false
    -> nvic@15

// timer3 is declared by the target overlay: it is the capture timer on
// every G0 group so far, and belongs with the DMA channel and input pin
// that go with it.

// These timers are not AM32 control-loop interrupt sources. The derived
// counter model keeps their register/time behavior without the five permanent
// clock entries created by each general STM32 timer.
timer4: Timers.AM32_STM32_FreeRunningTimer @ sysbus 0x40000800
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@16

timer6: Timers.AM32_STM32_BasicTimer @ sysbus 0x40001000
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@17

timer7: Timers.AM32_STM32_FreeRunningTimer @ sysbus 0x40001400
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@18

timer14: Timers.AM32_STM32_BasicTimer @ sysbus 0x40002000
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@19

timer15: Timers.AM32_STM32_FreeRunningTimer @ sysbus 0x40014000
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@20

// timer16 is declared by the target overlay alongside timer3: five G0
// groups capture the throttle on TIM16_CH1 instead of TIM3_CH1, so
// which of the two is the capture timer is a per target choice.

timer17: Timers.AM32_STM32_FreeRunningTimer @ sysbus 0x40014800
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@22

fdcan1: CAN.STMCAN @ sysbus <0x40006400, +0x400>
fdcan2: CAN.STMCAN @ sysbus <0x40006800, +0x400>

rtc: Timers.STM32F4_RTC @ sysbus 0x40002800
    AlarmIRQ -> exti@19

rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
   lastVal = 0
   data = {'hsion': 1, 'pllon': 0, 'sw': 0, 'lsion': 0}
self.NoisyLog("%s on FLIPFLOP at offset 0x%x, value 0x%x, length %d, %s" % (str(request.Type), request.Offset, request.Value, request.Length, str(data)))

if request.IsWrite:
    if request.Offset == 0x0:
        # HSION [doc = "Bit 8 - HSI16 clock enable"]
        data['hsion'] = (request.Value >> 8) & 0x1
        # PLLON [doc = "Bit 24 - PLL enable"]
        data['pllon'] = (request.Value >> 24) & 0x1
    elif request.Offset == 0x8:
        # SW_W [doc = "Bits 0:2 - System clock switch"]
        data['sw'] = request.Value & 0x7
    elif request.Offset == 0x60:
        data['lsion'] = request.Value & 0x1
elif request.IsRead:
    lastVal = 1 - lastVal
    if request.Offset == 0x0:
        # request.Value = lastVal * 0x83

        # RCC_CR [doc = "0x00 - Clock control register"]
        # HSION_RW [doc = "Bit 8 - HSI16 clock enable flag"]
        # HSIRDY_R [doc = "Bit 10 - HSI16 clock ready flag"] # HSIRDY == HISON for this model
        # PLLRDY [doc = "Bit 25 - PLL clock ready flag"]
        request.Value = (data['hsion'] << 8) | (data['hsion'] << 10) | (data['pllon'] << 25)
    elif request.Offset == 0x4:
        request.Value = lastVal * 0xFFFFFFF8
    elif request.Offset == 0x24:
        request.Value = 0x0
    elif request.Offset == 0x60:
        request.Value = (data['lsion'] << 1)
    else:
        # RCC_CFGR [doc = "0x08 - Clock configuration register"]
        # SWS_R [doc = "Bits 3:5 - System clock switch status"]
        # request.Value = lastVal * 0xFFFFFFFF
        request.Value = data['sw'] << 3

self.NoisyLog("  0x%x (%s)" % (request.Value, str(data)))
'''

// Our request driven DMA rather than Renode's STM32G0DMA, because the
// capture timer signals a transfer by raising a GPIO line and the stock
// model has no such input. The classic DMA register layout is the same
// on F0 and G0, so the F0 model serves both. IRQ wiring is left to the
// overlay, which knows which channel carries the capture.
// named "dma" rather than "dma1" so the generated overlay wires the
// capture and ADC channels the same way on both families
dma: DMA.AM32_STM32F0_DMA @ sysbus 0x40020000
    numberOfChannels: 7

// DMAMUX routes peripheral requests to channels on the G0, where the F0
// had a fixed mapping. The platform hardwires the routing instead, so
// this exists only to keep the firmware's writes from warning - a
// deliberate deviation: it means the DMAMUX configuration itself is not
// checked by the emulator.
dmamux: Miscellaneous.AM32_RegisterFile @ sysbus <0x40020800, +0x400>

// SYSCFG. Not a comparator page here as it is on the F051; the G0 puts
// the comparators at 0x40010200, declared by the overlay.
syscfg: Miscellaneous.AM32_RegisterFile @ sysbus <0x40010000, +0x200>

dma2: DMA.STM32G0DMA @ sysbus 0x40020400
    numberOfChannels: 5
    [0-4] -> nvicInput11@[4-8]

// the adc is declared by the target overlay, as on the F051: its
// channels and scaling differ per target

// Ours rather than Renode's Timers.STM32_IndependentWatchdog, for the
// same reason as on the F051: it accepts the key writes and counts them
// but never resets the machine. The firmware kicks it from the main
// loop, so a real watchdog would fire only when the emulation itself
// stalls, which resets the CPU and hides the actual problem.
iwdg: Miscellaneous.AM32_STM32_IWDG @ sysbus <0x40003000, +0x400>

flash_ctrl: MTD.STM32F4_FlashController @ sysbus 0x40022000
    flash: flash

// factory calibration page. The 1kHz ADC path reads the temperature
// calibration halfwords at 0x1FFF75A8 and 0x1FFF75CA on the G0; an
// unbacked pair divides by zero in __LL_ADC_CALC_TEMPERATURE.
systemMemory: Memory.MappedMemory @ sysbus 0x1FFF7000
    size: 0x1000

// The bridge that couples the emulated FETs to the SITL motor physics
// is declared by the target overlay, not here: its phase pin map is a
// required constructor argument and differs per target. So is the
// throttle generator, together with the wiring that drives it.
//
// Both sit at 0x60000000 and above on the G0. Neither can go at
// 0x50000000 as on the F051, because that is GPIOA here.

// Alternate function mapping connections. For more details see `stm32l071.repl`.
// timer1's stock alternate-function block is deliberately gone. A later
// connection block REPLACES an earlier one, so leaving it would silently
// overwrite the nvic wiring above with pin outputs. The motor model
// samples TIM1 by querying OutputRef(), not by listening for edges.
// timer3's block is gone for the same reason - it is the capture timer,
// an input only, and its block would have overridden the DMA wiring.

sysbus:
    init:
        Tag <0x40002C00, 0x40002FFF> "WWDG"
        Tag <0x40005C00, 0x40005FFF> "USB "
        Tag <0x40006C00, 0x40006FFF> "CRS"
        Tag <0x40007000, 0x400073FF> "PWR"
        Tag <0x40007400, 0x400077FF> "DAC"
        Tag <0x40007800, 0x40007BFF> "CEC"
        Tag <0x40015800, 0x40015BFF> "DBG"
        Tag <0x40023000, 0x400233FF> "CRC"
