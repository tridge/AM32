// GD32E230 common to every AM32 E230 target. Not loadable on its own:
// the capture timer, the ADC, the comparator, the bridge and the
// throttle wiring come from a generated target overlay.
//
// GigaDevice's Cortex-M23 clone of the STM32F0 generation, and a
// faithful one: GPIO (CTL=MODER, AFSEL=AFR), the timer block including
// CCHP=BDTR, EXTI, the five-channel DMA, the FWDGT watchdog and the
// single CMP (bit-identical to the F051's COMP1 half, same CSR
// address, same input-select encodings, same EXTI line 21) all match
// the STM32 models bit for bit under GD names. TIMERn here is ST's
// TIM(n+1): TIMER0 is the advanced PWM timer, TIMER5 the interval
// timer, TIMER13 the 20kHz loop, TIMER15 the commutation timer,
// TIMER16 the microsecond counter. The one real divergence is the
// ADC, which is the F1-generation register file (RSQ rank sequencer,
// RDATA at 0x4C, CLB/RSTCLB calibration) - the same layout the
// CH32V203 uses, so the WCH model serves.

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xC0
    systickFrequency: 72000000
    IRQ -> cpu@0

exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40010400
    numberOfOutputLines: 32
    [0, 1] -> nvicInput5@[0, 1]
    [2, 3] -> nvicInput6@[0, 1]
    [4-15] -> nvicInput7@[0-11]
    [21] -> nvicInput12@[0]

nvicInput5: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@5

nvicInput6: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@6

// EXTI4_15: the BEMF lines never land here, but line 15 does - the
// DMA ISR software-pends it through SWIER to tail-chain processDshot()
// at low priority, with no GPIO or trigger behind it at all
nvicInput7: Miscellaneous.CombinedInput @ none
    numberOfInputs: 12
    -> nvic@7

// ADC_CMP_IRQn, raised by the comparator through EXTI line 21
nvicInput12: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@12

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m23"
    nvic: nvic

// USART0 at the F0 USART1 address with the F0 register file
usart0: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 72000000
    IRQ -> nvic@27

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    modeResetValue: 0x28000000
    pullUpPullDownResetValue: 0x24000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x48000800, +0x400>
    modeResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x48001400, +0x400>
    modeResetValue: 0x28000000
    pullUpPullDownResetValue: 0x24000000
    numberOfAFs: 8
    [0-15] -> exti@[0-15]

// TIMER0: the advanced PWM timer (= TIM1), same model as everywhere
timer0: Timers.AM32_STM32_AdvancedTimer @ sysbus 0x40012C00
    frequency: 72000000
    0 -> nvic@13
    1 -> nvic@14

// timer2 (capture, = TIM3) is declared by the target overlay.

// TIMER5 (= TIM6): the free-running 2MHz interval timer
timer5: Timers.STM32_Timer @ sysbus 0x40001000
    frequency: 72000000
    initialLimit: 0xFFFF
    -> nvic@17

// TIMER13 (= TIM14): the 20kHz loop timer
timer13: Timers.STM32_Timer @ sysbus 0x40002000
    frequency: 72000000
    initialLimit: 0xFFFF
    -> nvic@19

// TIMER14 (= TIM15): the WS2812 timer on the GD_A boards; its
// PWM+DMA strip is not modelled (nothing decodes it), the registers
// just have somewhere real to land
timer14: Timers.STM32_Timer @ sysbus 0x40014000
    frequency: 72000000
    initialLimit: 0xFFFF
    -> nvic@20

// TIMER15 (= TIM16): the commutation timer
timer15: Timers.STM32_Timer @ sysbus 0x40014400
    frequency: 72000000
    initialLimit: 0xFFFF
    -> nvic@21

// TIMER16 (= TIM17): the microsecond counter delayMicros() spins on
timer16: Timers.STM32_Timer @ sysbus 0x40014800
    frequency: 72000000
    initialLimit: 0xFFFF
    -> nvic@22

// RCU: enable-to-ready flip-flops at the F0-style offsets. CTL0's
// IRC8M/HXTAL/PLL ready bits mirror their enables and CFG0's SCSS
// mirrors SCS, which is everything system_clock_72m_irc8m() polls.
rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    data = {'ctl0': 0x101, 'cfg0': 0}

if request.IsWrite:
    if request.Offset == 0x0:
        data['ctl0'] = request.Value
    elif request.Offset == 0x4:
        data['cfg0'] = request.Value
elif request.IsRead:
    if request.Offset == 0x0:
        # IRC8MSTB(1) <- IRC8MEN(0), HXTALSTB(17) <- HXTALEN(16),
        # PLLSTB(25) <- PLLEN(24)
        v = data['ctl0']
        request.Value = v | ((v & 1) << 1) | (((v >> 16) & 1) << 17) | (((v >> 24) & 1) << 25)
    elif request.Offset == 0x4:
        # SCSS[3:2] mirrors SCS[1:0]
        v = data['cfg0']
        request.Value = (v & ~0xC) | ((v & 3) << 2)
    else:
        request.Value = 0
'''

// FMC: fmc_ready_wait() polls a BUSY that always reads clear; the
// programming stores go straight to the flash addresses, which
// MappedMemory accepts, and page erase is a no-op save_flash_nolib()
// tolerates by rewriting the whole page. STAT (0x0C) must read as
// zero: fmc_flag_clear() writes the W1C error bits there, and a
// stored WPERR makes fmc_word_program() skip every later store.
fmc: Miscellaneous.AM32_RegisterFile @ sysbus <0x40022000, +0x400>
    readAsZero: 0xC

// FWDGT: same register file as the STM32 IWDG (plus a window register
// our model ignores); ours rather than a real watchdog, as everywhere
iwdg: Miscellaneous.AM32_STM32_IWDG @ sysbus <0x40003000, +0x400>

// 64K flash with the image using the low 32K; app at 0x08001000 above
// an empty 4K bootloader region. The K8 die has 8K of SRAM - the
// linker script declares 16K but places the stack top at 8K
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x10000

flashAlias: Memory.MappedMemory @ sysbus 0x0
    size: 0x10000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x2000

// no factory calibration on this part - the temperature formula is
// fixed constants - but the WCH ADC model reads its reference point
// from a seeded word here (the .resc writes the GD datasheet values)
systemMemory: Memory.MappedMemory @ sysbus 0x1FFFF000
    size: 0x1000

// five channels; the capture arrives on GD channel 3 (the classic
// STM32 channel-4 slot) and the ADC on GD channel 0 (slot 1)
dma: DMA.AM32_STM32F0_DMA @ sysbus 0x40020000
    numberOfChannels: 5

sysbus:
    init:
        Tag <0x40002C00, 0x40002FFF> "WWDGT"
        Tag <0x40004400, 0x400047FF> "USART1"
        Tag <0x40005400, 0x400057FF> "I2C0"
        Tag <0x40007000, 0x400073FF> "PMU"
        Tag <0x40013000, 0x400133FF> "SPI0"
        Tag <0x40015800, 0x40015BFF> "DBG"
        Tag <0x40023000, 0x400233FF> "CRC"
